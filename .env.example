# ==============================================================================
# AURA PORTAL - CLOUD ENVIRONMENT VARIABLES (SUPABASE & RENDER)
# ==============================================================================

# 1. Cloud Database (Supabase PostgreSQL / Render PostgreSQL / Neon)
# Copy from Supabase Project Settings -> Database -> Connection string (URI)
# Leave blank to use local SQLite database (texts.db)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# 2. Cloud Media Storage (Supabase Storage - 1GB Free Permanent Bucket)
# Copy from Supabase Project Settings -> API (Project URL & anon/service key)
# Leave blank to store uploads locally in static/uploads/
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-ANON-OR-SERVICE-KEY]
SUPABASE_BUCKET=memories

# 3. Dynamic Server Port (Provided automatically by Render)
PORT=8000

