# ==============================================================================
# AURA PORTAL - CLOUD ENVIRONMENT VARIABLES
# ==============================================================================

# 1. Cloud Database (Render PostgreSQL / Neon / Supabase)
# Leave blank to use local SQLite database (texts.db)
DATABASE_URL=postgresql://aurauser:password@host/auradb

# 2. Cloud Media CDN (Cloudinary - Free 25GB Storage for Images/Videos/Audio)
# Copy from your Cloudinary Dashboard: https://cloudinary.com/console
# Leave blank to store uploads locally in static/uploads/
CLOUDINARY_URL=cloudinary://<API_KEY>:<API_SECRET>@<CLOUD_NAME>

# 3. Dynamic Server Port (Provided automatically by Render)
PORT=8000
