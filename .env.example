# ==============================================================================
# AURA CINEMATIC PORTAL - SUPABASE CLOUD CONFIGURATION
# ==============================================================================
# IMPORTANT: All user data and media uploads are permanently stored in Supabase.
# Local SQLite and Render disk storage are COMPLETELY DISABLED.
# You MUST set these environment variables in your Render Dashboard or local .env.
# ==============================================================================

# 1. Supabase PostgreSQL Connection String (DATABASE_URL)
# NOTE FOR RENDER: Use the Supabase Connection Pooler URI (Session/Transaction mode on port 6543 or 5432)
# because Render free containers require IPv4 outbound connectivity.
# Find this in: Supabase Dashboard -> Project Settings -> Database -> Connection string -> URI (Mode: Session)
# Format: postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://postgres.vkzzdneprmwhsnzmeozx:[YOUR-PASSWORD]@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# 2. Supabase Storage API (SUPABASE_URL & SUPABASE_KEY)
# Find in: Supabase Dashboard -> Project Settings -> API
# - Project URL (e.g., https://vkzzdneprmwhsnzmeozx.supabase.co)
# - API Keys: Use either 'service_role' (recommended for backend) or 'anon'
SUPABASE_URL=https://vkzzdneprmwhsnzmeozx.supabase.co
SUPABASE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-OR-ANON-KEY]

# 3. Supabase Storage Bucket Name (Default: memories)
# Ensure the bucket is created in Supabase Storage with "Public" access enabled.
SUPABASE_BUCKET=memories

# 4. Server Port (Set automatically by Render)
PORT=8000
